# ==============================================================================
# Office Knowledge Assistant - Environment Configuration Template
# ==============================================================================

# Application Configuration
PROJECT_NAME="Office Knowledge Assistant"
APP_DISPLAY_NAME="Office Knowledge Assistant"
# Optional alternate names: "Office AI Copilot", "Bhasha Office Assistant", "Namma Office AI", "Office Sahayak"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & Authentication
SECRET_KEY="dev-secret-key-change-in-production-office-knowledge-assistant"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MOCK_AUTH_ENABLED=true

# Database Storage
# Local SQLite default for development / PostgreSQL ready for production
DATABASE_URL="sqlite:///./data/office_knowledge.db"
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/office_knowledge

# LLM & Embedding Providers
# Options: "built-in" (smart local engine), "gemini", "openai", "anthropic"
LLM_PROVIDER="built-in"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
EMBEDDING_PROVIDER="built-in" # "built-in" or "huggingface" or "openai"

# Real-time Web Search Configuration
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER="mock_or_official" # "mock_or_official", "serper", "tavily"
SERPER_API_KEY=""
TAVILY_API_KEY=""

# Hugging Face Dataset Governance & Licensing Gates
# CRITICAL: Public datasets are NEVER merged into the private office RAG knowledge base.
ACCEPT_DATASET_LICENSES=false
HF_TOKEN=""
ENABLE_VOICE_DATASETS=false
DATASET_STORAGE_PATH="./data/public"
PRIVATE_DOCS_STORAGE_PATH="./data/private"

# User Experience & Defaults
DEFAULT_REPLY_LANGUAGE="auto" # "auto", "eng_Latn", "hin_Deva", "hin_Latn", "mal_Mlym", "mal_Latn"
DEFAULT_ANSWER_DEPTH="standard" # "concise", "standard", "detailed"
MAX_MEMORY_ITEMS_PER_USER=50
SHORT_TERM_MEMORY_TURNS=10
